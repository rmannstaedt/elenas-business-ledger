<Window x:Class="ElenasBusinessLedger.App.Views.InvoiceCandidateDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Write Invoice"
        Height="360"
        Width="440"
        MinHeight="320"
        MinWidth="400"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </Window.Resources>

    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Bottom"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,14,0,0">
            <Button Content="Continue"
                    Command="{Binding ConfirmCommand}"
                    MinWidth="92"
                    Height="32"
                    Margin="0,0,8,0" />
            <Button Content="Cancel"
                    Click="OnCancel"
                    MinWidth="84"
                    Height="32" />
        </StackPanel>

        <Border DockPanel.Dock="Top"
                Background="#FFF4E5"
                BorderBrush="#D58512"
                BorderThickness="1"
                Padding="10"
                Margin="0,0,0,12"
                Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}">
            <TextBlock Text="{Binding ErrorMessage}"
                       TextWrapping="Wrap" />
        </Border>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock Text="Students with lessons today"
                       FontSize="16"
                       FontWeight="SemiBold"
                       Margin="0,0,0,8" />
            <ListBox Grid.Row="1"
                     ItemsSource="{Binding CandidateStudentShortNames}"
                     SelectedItem="{Binding SelectedStudentShortName}"
                     MinHeight="80" />

            <TextBlock Grid.Row="2"
                       Text="All students"
                       FontSize="16"
                       FontWeight="SemiBold"
                       Margin="0,14,0,8" />
            <ListBox Grid.Row="3"
                     ItemsSource="{Binding AllStudentShortNames}"
                     SelectedItem="{Binding SelectedStudentShortName}"
                     MinHeight="80" />
        </Grid>
    </DockPanel>
</Window>
