<Window x:Class="MySmallBusinessLedger.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="My Small Business Ledger"
        Height="720"
        Width="1120"
        MinHeight="620"
        MinWidth="960"
        Loaded="OnLoaded"
        Activated="OnActivated"
        Deactivated="OnWindowDeactivated"
        PreviewMouseLeftButtonDown="OnWindowPreviewMouseLeftButtonDown">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <Style x:Key="QuietIconButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#8A1F1F" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#FFF0F0" />
                                <Setter Property="BorderBrush" Value="#D18B8B" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter Property="BorderBrush" Value="#7AA7D9" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="HeaderArrowButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#5B6472" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#EEF3F8" />
                                <Setter Property="BorderBrush" Value="#A9B7C7" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter Property="BorderBrush" Value="#7AA7D9" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#B5BAC2" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="LessonTableCellStyle" TargetType="{x:Type DataGridCell}">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style x:Key="CenteredColumnHeaderStyle" TargetType="{x:Type DataGridColumnHeader}">
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>
        <Style x:Key="CenteredTextCellStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="LessonCellButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=DataGridCell}}" />
            <Setter Property="Padding" Value="4,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#EEF3F8" />
                                <Setter Property="Foreground" Value="#111827" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#6A8FBF" />
                                <Setter TargetName="Chrome" Property="BorderThickness" Value="1" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <DockPanel Background="#F6F7F9">
        <Menu DockPanel.Dock="Top" Background="#FFFFFF">
            <MenuItem Header="_Application">
                <MenuItem Header="_Settings"
                          Command="{Binding OpenSettingsCommand}" />
            </MenuItem>
            <MenuItem Header="_Student">
                <MenuItem Header="_Manage Students"
                          Command="{Binding OpenManageStudentsCommand}" />
            </MenuItem>
            <MenuItem Header="_Plan">
                <MenuItem Header="_Manage Plans"
                          Command="{Binding OpenManagePlansCommand}" />
            </MenuItem>
        </Menu>

        <Grid x:Name="RootGrid"
              Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <Button Command="{Binding PreviousStudentCommand}"
                                Style="{StaticResource HeaderArrowButtonStyle}"
                                ToolTip="Previous student"
                                AutomationProperties.Name="Previous student">
                            <Path Data="M 8,2 L 2,8 L 8,14"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="2"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round" />
                        </Button>
                        <TextBlock Text="{Binding CurrentStudentShortName, TargetNullValue=No student selected}"
                                   FontSize="30"
                                   FontWeight="SemiBold"
                                   Foreground="#15191F"
                                   Margin="4,0"
                                   VerticalAlignment="Center" />
                        <Button Command="{Binding NextStudentCommand}"
                                Style="{StaticResource HeaderArrowButtonStyle}"
                                ToolTip="Next student"
                                AutomationProperties.Name="Next student">
                            <Path Data="M 2,2 L 8,8 L 2,14"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="2"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round" />
                        </Button>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Margin="0,4,0,0">
                        <Button Command="{Binding PreviousMonthCommand}"
                                Style="{StaticResource HeaderArrowButtonStyle}"
                                Width="30"
                                Height="20"
                                ToolTip="Previous month"
                                AutomationProperties.Name="Previous month">
                            <Path Data="M 6,3 L 2,7 L 6,11"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.5"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round" />
                        </Button>
                        <TextBlock Text="{Binding DisplayMonthText}"
                                   FontSize="15"
                                   Foreground="#5B6472"
                                   Margin="4,0"
                                   VerticalAlignment="Center" />
                        <Button Command="{Binding NextMonthCommand}"
                                Style="{StaticResource HeaderArrowButtonStyle}"
                                Width="30"
                                Height="20"
                                ToolTip="Next month"
                                AutomationProperties.Name="Next month">
                            <Path Data="M 2,3 L 6,7 L 2,11"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.5"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round" />
                        </Button>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Button Content="Open Calendar"
                            Command="{Binding OpenCalendarCommand}"
                            MinWidth="112"
                            Height="34"
                            Margin="0,0,8,0"
                            AutomationProperties.Name="Open Google Calendar" />
                    <Button Content="Refresh"
                            Command="{Binding RefreshCommand}"
                            MinWidth="86"
                            Height="34"
                            Margin="0,0,8,0"
                            AutomationProperties.Name="Refresh lessons" />
                    <Button Content="Write Invoice"
                            Command="{Binding WriteInvoiceCommand}"
                            MinWidth="112"
                            Height="34"
                            AutomationProperties.Name="Write invoice" />
                </StackPanel>
            </Grid>

            <Border Grid.Row="1"
                    Background="#FFF4E5"
                    BorderBrush="#D58512"
                    BorderThickness="1"
                    Padding="10"
                    Margin="0,0,0,14"
                    Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding ErrorMessage}"
                               Foreground="#5F370E"
                               TextWrapping="Wrap" />
                    <Button Grid.Column="1"
                            Content="×"
                            Command="{Binding DismissErrorCommand}"
                            Style="{StaticResource QuietIconButtonStyle}"
                            Width="24"
                            Height="22"
                            Margin="10,0,0,0"
                            AutomationProperties.Name="Dismiss message" />
                </Grid>
            </Border>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" MinWidth="300" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0"
                      Width="480"
                      HorizontalAlignment="Left"
                      AutomationProperties.Name="Lessons pane">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Left">
                            <Button Content="Add Lesson"
                                    Command="{Binding AddLessonCommand}"
                                    PreviewMouseLeftButtonDown="OnCommandButtonPreviewMouseLeftButtonDown"
                                    MinWidth="96"
                                    Height="32" />
                            <Button Content="Populate Calendar"
                                    Command="{Binding PopulateCalendarCommand}"
                                    MinWidth="128"
                                    Height="32"
                                    Margin="8,0,0,0"
                                    AutomationProperties.Name="Populate calendar from student schedule" />
                        </StackPanel>
                    </Grid>

                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding Lessons}"
                              SelectedItem="{Binding SelectedLesson, Mode=TwoWay}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              CanUserReorderColumns="False"
                              IsReadOnly="False"
                              BorderBrush="#8EA6C3"
                              BorderThickness="1"
                              CellStyle="{StaticResource LessonTableCellStyle}"
                              HeadersVisibility="Column"
                              GridLinesVisibility="All"
                              HorizontalGridLinesBrush="#C7D3E1"
                              SelectionMode="Single"
                              VerticalGridLinesBrush="#C7D3E1"
                              SelectionChanged="OnGridSelectionChanged"
                              AutomationProperties.Name="Lesson list">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Date" Width="125">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button x:Name="LessonDateButton"
                                                IsEnabled="{Binding CanEdit}"
                                                PreviewMouseLeftButtonDown="OnLessonDateButtonPreviewMouseLeftButtonDown"
                                                Click="OnLessonDateButtonClick"
                                                Style="{StaticResource LessonCellButtonStyle}"
                                                HorizontalContentAlignment="Left"
                                                Padding="6,0,4,0"
                                                AutomationProperties.Name="Open lesson date selector">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding StartsOnDateText}"
                                                           VerticalAlignment="Center" />
                                                <Path Data="M 3,4 L 7,8 L 11,4"
                                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                      StrokeThickness="1.2"
                                                      StrokeStartLineCap="Round"
                                                      StrokeEndLineCap="Round"
                                                      StrokeLineJoin="Round"
                                                      Width="14"
                                                      Height="12"
                                                      Stretch="None"
                                                      Margin="6,0,0,0"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Time" Width="70">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button x:Name="LessonTimeButton"
                                                IsEnabled="{Binding CanEdit}"
                                                PreviewMouseLeftButtonDown="OnLessonTimeButtonPreviewMouseLeftButtonDown"
                                                Click="OnLessonTimeButtonClick"
                                                Style="{StaticResource LessonCellButtonStyle}"
                                                HorizontalContentAlignment="Left"
                                                Padding="6,0,4,0"
                                                Width="70"
                                                AutomationProperties.Name="Open lesson time selector">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding StartsAtTimeText}"
                                                           VerticalAlignment="Center" />
                                                <Path Data="M 3,4 L 7,8 L 11,4"
                                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                      StrokeThickness="1.2"
                                                      StrokeStartLineCap="Round"
                                                      StrokeEndLineCap="Round"
                                                      StrokeLineJoin="Round"
                                                      Width="14"
                                                      Height="12"
                                                      Stretch="None"
                                                      Margin="8,0,0,0"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="State"
                                                    HeaderStyle="{StaticResource CenteredColumnHeaderStyle}"
                                                    Width="118">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="{Binding StateText}"
                                                Command="{Binding DataContext.ToggleLessonStateCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"
                                                PreviewMouseLeftButtonDown="OnCommandButtonPreviewMouseLeftButtonDown"
                                                IsEnabled="{Binding CanToggleState}"
                                                Style="{StaticResource LessonCellButtonStyle}"
                                                HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Center"
                                                ToolTip="{Binding StateToggleToolTip}"
                                                Height="25"
                                                AutomationProperties.Name="{Binding StateToggleToolTip}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Invoiced"
                                                Binding="{Binding InvoicedText}"
                                                ElementStyle="{StaticResource CenteredTextCellStyle}"
                                                HeaderStyle="{StaticResource CenteredColumnHeaderStyle}"
                                                IsReadOnly="True"
                                                Width="80" />
                            <DataGridTextColumn Header="Paid"
                                                Binding="{Binding PaymentStatusText}"
                                                CanUserResize="False"
                                                ElementStyle="{StaticResource CenteredTextCellStyle}"
                                                HeaderStyle="{StaticResource CenteredColumnHeaderStyle}"
                                                IsReadOnly="True"
                                                Width="*" />
                            <DataGridTemplateColumn Header=""
                                                    CanUserResize="False"
                                                    Width="44">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="×"
                                                Command="{Binding DataContext.DeleteLessonCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"
                                                PreviewMouseLeftButtonDown="OnCommandButtonPreviewMouseLeftButtonDown"
                                                Visibility="{Binding CanEdit, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                Style="{StaticResource QuietIconButtonStyle}"
                                                ToolTip="Delete lesson"
                                                Width="28"
                                                Height="24"
                                                AutomationProperties.Name="Delete lesson" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>

                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Text="Student Invoices"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Margin="0,0,0,10" />
                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding Invoices}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              IsReadOnly="True"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              SelectionChanged="OnGridSelectionChanged"
                              MouseDoubleClick="OnInvoiceDoubleClick"
                              AutomationProperties.Name="Student invoices">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Invoice"
                                                Binding="{Binding InvoiceNumberText}"
                                                MinWidth="90"
                                                Width="1*" />
                            <DataGridTextColumn Header="Date"
                                                Binding="{Binding InvoiceDateText}"
                                                MinWidth="100"
                                                Width="1*" />
                            <DataGridTextColumn Header="Print"
                                                Binding="{Binding PrintStatusText}"
                                                MinWidth="92"
                                                Width="0.9*" />
                            <DataGridTemplateColumn Header="Status"
                                                    MinWidth="120"
                                                    Width="1.2*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="{Binding PaymentStatusText}"
                                                Command="{Binding DataContext.ToggleInvoicePaymentStatusCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"
                                                PreviewMouseLeftButtonDown="OnCommandButtonPreviewMouseLeftButtonDown"
                                                MinWidth="104"
                                                Height="28"
                                                AutomationProperties.Name="{Binding PaymentStatusText}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
