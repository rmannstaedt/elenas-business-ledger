<Window x:Class="MySmallBusinessLedger.App.Views.InvoicePreviewView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Invoice Preview"
        Height="620"
        Width="760"
        MinHeight="560"
        MinWidth="680"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </Window.Resources>

    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Bottom"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,14,0,0">
            <Button Content="Print Invoice"
                    Command="{Binding PrintInvoiceCommand}"
                    MinWidth="110"
                    Height="32"
                    Margin="0,0,8,0" />
            <Button Content="Cancel"
                    Click="OnCancel"
                    MinWidth="84"
                    Height="32" />
        </StackPanel>

        <Border DockPanel.Dock="Top"
                Background="#FFF4E5"
                BorderBrush="#D58512"
                BorderThickness="1"
                Padding="10"
                Margin="0,0,0,12"
                Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}">
            <TextBlock Text="{Binding ErrorMessage}"
                       TextWrapping="Wrap" />
        </Border>

        <Border DockPanel.Dock="Top"
                Background="#E8F1FB"
                BorderBrush="#6C8FB3"
                BorderThickness="1"
                Padding="10"
                Margin="0,0,0,12"
                Visibility="{Binding HasBusyStatus, Converter={StaticResource BooleanToVisibilityConverter}}">
            <TextBlock Text="{Binding BusyStatusText}"
                       TextWrapping="Wrap" />
        </Border>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="Fra"
                               FontWeight="SemiBold" />
                    <TextBlock Text="{Binding CompanyName}" />
                    <TextBlock Text="{Binding CompanyAddress}" />
                    <TextBlock Text="{Binding InvoiceDateText}"
                               Margin="0,8,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="1">
                    <TextBlock Text="Til"
                               FontWeight="SemiBold" />
                    <TextBlock Text="{Binding StudentName}" />
                    <TextBlock Text="{Binding StudentAddress}" />
                </StackPanel>
            </Grid>

            <TextBlock Grid.Row="1"
                       Text="Lessons"
                       FontSize="18"
                       FontWeight="SemiBold"
                       Margin="0,18,0,8" />

            <DataGrid x:Name="InvoiceLinesGrid"
                      Grid.Row="2"
                      ItemsSource="{Binding Lines}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      CanUserResizeRows="False"
                      IsReadOnly="False"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="Include"
                                            Width="70">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsIncluded, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          AutomationProperties.Name="{Binding IncludeAutomationName}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          PreviewMouseLeftButtonDown="OnIncludeLinePreviewMouseLeftButtonDown" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Lesson"
                                        Binding="{Binding LessonDateTimeText}"
                                        IsReadOnly="True"
                                        Width="150" />
                    <DataGridTextColumn Header="Plan"
                                        Binding="{Binding PlanName}"
                                        IsReadOnly="True"
                                        Width="*" />
                    <DataGridTextColumn Header="Price without VAT"
                                        Binding="{Binding PriceWithoutVatText}"
                                        IsReadOnly="True"
                                        Width="140" />
                </DataGrid.Columns>
            </DataGrid>

            <Grid Grid.Row="3"
                  Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="220" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="Price adjustment" />
                    <Grid Margin="0,3,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding PriceAdjustmentAmountText, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBox Grid.Column="2"
                                 Text="{Binding PriceAdjustmentReason, UpdateSourceTrigger=PropertyChanged}" />
                    </Grid>
                </StackPanel>

                <StackPanel Grid.Column="1"
                            HorizontalAlignment="Right">
                    <TextBlock Text="{Binding TotalWithoutVatText, StringFormat=I alt ekskl. moms: {0}}"
                               TextAlignment="Right" />
                    <TextBlock Text="{Binding VatAmountText, StringFormat=Moms: {0}}"
                               TextAlignment="Right" />
                    <TextBlock Text="{Binding TotalText, StringFormat=I alt: {0}}"
                               FontSize="16"
                               FontWeight="SemiBold"
                               TextAlignment="Right" />
                </StackPanel>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
