<Window x:Class="MySmallBusinessLedger.App.Views.PlanCatalogView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Manage Plans"
        Height="560"
        Width="860"
        MinHeight="500"
        MinWidth="760"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </Window.Resources>

    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Bottom"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,14,0,0">
            <Button Content="Close"
                    Click="OnClose"
                    MinWidth="84"
                    Height="32" />
        </StackPanel>

        <Border DockPanel.Dock="Top"
                Background="#FFF4E5"
                BorderBrush="#D58512"
                BorderThickness="1"
                Padding="10"
                Margin="0,0,0,12"
                Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}">
            <TextBlock Text="{Binding ErrorMessage}"
                       TextWrapping="Wrap" />
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Plans"
                               FontSize="18"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                    <Button Grid.Column="1"
                            Content="Add Plan"
                            Command="{Binding AddDraftPlanCommand}"
                            MinWidth="88"
                            Height="28" />
                </Grid>

                <DataGrid Grid.Row="1"
                          ItemsSource="{Binding PlansView}"
                          SelectedItem="{Binding SelectedPlan}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          IsReadOnly="True"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          AutomationProperties.Name="Plan list">
                    <DataGrid.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}"
                                               FontWeight="SemiBold"
                                               Margin="4,8,0,4" />
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </DataGrid.GroupStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Name"
                                            Binding="{Binding Name}"
                                            Width="*" />
                        <DataGridTextColumn Header="Price"
                                            Binding="{Binding PriceWithoutVatText}"
                                            Width="90" />
                        <DataGridTextColumn Header="State"
                                            Binding="{Binding StateText}"
                                            Width="100" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>

            <StackPanel Grid.Column="2">
                <TextBlock Text="Selected Plan"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Margin="0,0,0,10" />
                <TextBlock Text="Name" />
                <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                         IsEnabled="{Binding CanEditSelectedPlanFields}"
                         Margin="0,3,0,8" />
                <TextBlock Text="Price without VAT" />
                <TextBox Text="{Binding PriceWithoutVat, UpdateSourceTrigger=PropertyChanged}"
                         IsEnabled="{Binding CanEditSelectedPlanFields}"
                         Margin="0,3,0,8" />
                <TextBlock Text="Lessons per week" />
                <ComboBox ItemsSource="{Binding LessonsPerWeekOptions}"
                          SelectedItem="{Binding LessonsPerWeek}"
                          IsEnabled="{Binding CanEditSelectedPlanFields}"
                          Margin="0,3,0,8" />
                <TextBlock Text="Duration minutes" />
                <TextBox Text="{Binding DurationMinutes, UpdateSourceTrigger=PropertyChanged}"
                         IsEnabled="{Binding CanEditSelectedPlanFields}"
                         Margin="0,3,0,8" />
                <TextBlock Text="Flexibility" />
                <ComboBox ItemsSource="{Binding FlexibilityOptions}"
                          SelectedItem="{Binding Flexibility}"
                          IsEnabled="{Binding CanEditSelectedPlanFields}"
                          Margin="0,3,0,8" />
                <TextBlock Text="Number of students" />
                <TextBox Text="{Binding NumberOfStudents, UpdateSourceTrigger=PropertyChanged}"
                         IsEnabled="{Binding CanEditSelectedPlanFields}"
                         Margin="0,3,0,8" />
                <TextBlock Text="Effective date" />
                <DatePicker SelectedDate="{Binding EffectiveDate, UpdateSourceTrigger=PropertyChanged}"
                            IsEnabled="{Binding CanEditSelectedPlanFields}"
                            Margin="0,3,0,14" />

                <WrapPanel>
                    <Button Content="Save Draft"
                            Command="{Binding SaveDraftPlanCommand}"
                            Visibility="{Binding CanEditSelectedPlanFields, Converter={StaticResource BooleanToVisibilityConverter}}"
                            MinWidth="90"
                            Height="28"
                            Margin="0,0,8,8" />
                    <Button Content="Delete"
                            Command="{Binding DeleteDraftPlanCommand}"
                            Visibility="{Binding CanDeleteSelectedPlan, Converter={StaticResource BooleanToVisibilityConverter}}"
                            MinWidth="78"
                            Height="28"
                            Margin="0,0,8,8" />
                    <Button Content="Publish"
                            Command="{Binding PublishPlanCommand}"
                            Visibility="{Binding CanPublishSelectedPlan, Converter={StaticResource BooleanToVisibilityConverter}}"
                            MinWidth="78"
                            Height="28"
                            Margin="0,0,8,8" />
                    <Button Content="Archive"
                            Command="{Binding ArchivePlanCommand}"
                            Visibility="{Binding CanArchiveSelectedPlan, Converter={StaticResource BooleanToVisibilityConverter}}"
                            MinWidth="78"
                            Height="28"
                            Margin="0,0,8,8" />
                </WrapPanel>
            </StackPanel>
        </Grid>
    </DockPanel>
</Window>
