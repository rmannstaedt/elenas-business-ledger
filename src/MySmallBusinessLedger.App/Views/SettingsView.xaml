<Window x:Class="MySmallBusinessLedger.App.Views.SettingsView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Application Settings"
        Height="680"
        Width="720"
        MinHeight="560"
        MinWidth="640"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <Style x:Key="SettingsGroupBoxStyle"
               TargetType="GroupBox">
            <Setter Property="Margin"
                    Value="0,0,0,12" />
            <Setter Property="Padding"
                    Value="10" />
        </Style>
    </Window.Resources>

    <DockPanel Margin="16">
        <Border DockPanel.Dock="Top"
                Background="#FFF4E5"
                BorderBrush="#D58512"
                BorderThickness="1"
                Padding="10"
                Margin="0,0,0,12"
                Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}">
            <TextBlock Text="{Binding ErrorMessage}"
                       TextWrapping="Wrap" />
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Company"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Margin="0,0,0,10" />
                    <GroupBox Header="Contact"
                              Style="{StaticResource SettingsGroupBoxStyle}">
                        <StackPanel>
                            <TextBlock Text="Name" />
                            <TextBox Text="{Binding CompanyName, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,3,0,8" />
                            <TextBlock Text="Address" />
                            <TextBox Text="{Binding CompanyAddress, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,3,0,4" />
                            <TextBox Text="{Binding CompanyAddressLine2, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,3,0,8" />
                            <TextBlock Text="Phone" />
                            <TextBox Text="{Binding CompanyPhone, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,3,0,8" />
                            <TextBlock Text="Email" />
                            <TextBox Text="{Binding CompanyEmail, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,3,0,0" />
                        </StackPanel>
                    </GroupBox>
                    <GroupBox Header="Payment accounts"
                              Style="{StaticResource SettingsGroupBoxStyle}">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="3*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Reg. nr.:" />
                                    <TextBox Text="{Binding BankRegistrationNumber, UpdateSourceTrigger=PropertyChanged}"
                                             Margin="0,3,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Konto nr.:" />
                                    <TextBox Text="{Binding BankAccountNumber, UpdateSourceTrigger=PropertyChanged}"
                                             Margin="0,3,0,0" />
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="Mobile Pay Account" />
                            <TextBox Text="{Binding MobilePayAccount, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,3,0,0" />
                        </StackPanel>
                    </GroupBox>
                    <GroupBox Header="Invoicing"
                              Style="{StaticResource SettingsGroupBoxStyle}">
                        <StackPanel>
                            <TextBlock Text="Invoice folder" />
                            <Grid Margin="0,3,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0"
                                         Text="{Binding InvoiceFolderPath, UpdateSourceTrigger=PropertyChanged}" />
                                <Button Grid.Column="2"
                                        Content="Browse..."
                                        Click="OnBrowseInvoiceFolder"
                                        MinWidth="78"
                                        Height="24" />
                            </Grid>
                            <TextBlock Text="Invoice printer" />
                            <Grid Margin="0,3,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ComboBox Grid.Column="0"
                                          IsEditable="True"
                                          ItemsSource="{Binding AvailableInvoicePrinters}"
                                          Text="{Binding ConfiguredInvoicePrinterName, UpdateSourceTrigger=PropertyChanged}" />
                                <Button Grid.Column="2"
                                        Content="Clear"
                                        Command="{Binding ClearInvoicePrinterCommand}"
                                        MinWidth="64"
                                        Height="24" />
                            </Grid>
                            <TextBlock Text="Payment instructions:" />
                            <RadioButton Content="Betales ved modtagelse"
                                         GroupName="PaymentInstructions"
                                         IsChecked="{Binding IsPaymentDueOnReceipt}"
                                         Margin="0,5,0,4" />
                            <RadioButton Content="8 dage fra fakturadato"
                                         GroupName="PaymentInstructions"
                                         IsChecked="{Binding IsPaymentDueIn8Days}"
                                         Margin="0,0,0,4" />
                            <RadioButton Content="30 dage fra fakturadato"
                                         GroupName="PaymentInstructions"
                                         IsChecked="{Binding IsPaymentDueIn30Days}"
                                         Margin="0,0,0,4" />
                            <Grid Margin="0,0,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <RadioButton Grid.Column="0"
                                             Content="andet:"
                                             GroupName="PaymentInstructions"
                                             IsChecked="{Binding IsCustomPaymentInstructions}"
                                             VerticalAlignment="Center" />
                                <TextBox Grid.Column="2"
                                         Text="{Binding CustomPaymentInstructions, UpdateSourceTrigger=PropertyChanged}"
                                         IsEnabled="{Binding IsCustomPaymentInstructions}" />
                            </Grid>
                        </StackPanel>
                    </GroupBox>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="Google Calendar"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Margin="0,0,0,10" />
                    <TextBlock Text="Google calendar"
                               ToolTip="{Binding CalendarIdHelpText}" />
                    <TextBox Text="{Binding CalendarId, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="{Binding CalendarIdHelpText}"
                             Margin="0,3,0,8" />
                    <TextBlock Text="Google account email" />
                    <TextBox Text="{Binding GoogleAccountEmail, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,3,0,8" />
                    <TextBlock Text="{Binding GoogleOAuthAppStatusText}"
                               Foreground="#5B6472"
                               Margin="0,0,0,8" />
                    <StackPanel Orientation="Horizontal"
                                Margin="0,0,0,8">
                        <Button Content="Connect Google Calendar"
                                Command="{Binding ConnectGoogleCalendarCommand}"
                                MinWidth="150"
                                Height="28"
                                Margin="0,0,8,0" />
                        <Button Content="Forget Google sign-in"
                                Command="{Binding ForgetGoogleAuthorizationCommand}"
                                MinWidth="142"
                                Height="28" />
                    </StackPanel>
                    <TextBlock Text="{Binding GoogleAuthorizationStatusText}"
                               Foreground="#5B6472"
                               TextWrapping="Wrap"
                               Margin="0,0,0,18" />
                    <TextBlock Text="Application data"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Margin="0,8,0,10" />
                    <TextBlock Text="Database location" />
                    <TextBox Text="{Binding DatabasePath, Mode=OneWay}"
                             IsReadOnly="True"
                             Margin="0,3,0,8" />
                    <TextBlock Text="App data folder" />
                    <TextBox Text="{Binding AppDataFolderPath, Mode=OneWay}"
                             IsReadOnly="True"
                             Margin="0,3,0,8" />
                    <GroupBox Header="VAT"
                              Grid.Column="2"
                              Style="{StaticResource SettingsGroupBoxStyle}"
                              Margin="0,72,0,12">
                        <StackPanel>
                            <CheckBox Content="VAT registered"
                                      IsChecked="{Binding IsVatRegistered}"
                                      Margin="0,0,0,8" />
                            <TextBlock Text="VAT registration date" />
                            <DatePicker SelectedDate="{Binding VatRegistrationDate, UpdateSourceTrigger=PropertyChanged}"
                                        Margin="0,3,0,8" />
                            <TextBlock Text="CVR" />
                            <TextBox Text="{Binding CompanyCvr, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,3,0,0" />
                        </StackPanel>
                    </GroupBox>
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                Margin="0,40,0,0">
                        <Button Content="Save"
                                Command="{Binding SaveCommand}"
                                MinWidth="84"
                                Height="32"
                                Margin="0,0,8,0" />
                        <Button Content="Cancel"
                                Click="OnCancel"
                                MinWidth="84"
                                Height="32" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </DockPanel>
</Window>
