<Window x:Class="MySmallBusinessLedger.App.Views.StudentEditorView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Student"
        Height="640"
        Width="720"
        MinHeight="560"
        MinWidth="640"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <Style x:Key="CurrentPlanDetailTextStyle"
               TargetType="TextBlock">
            <Setter Property="Visibility"
                    Value="{Binding HasSelectedPlan, Converter={StaticResource BooleanToVisibilityConverter}}" />
        </Style>
        <Style x:Key="CurrentPlanDetailDatePickerStyle"
               TargetType="DatePicker">
            <Setter Property="Visibility"
                    Value="{Binding HasSelectedPlan, Converter={StaticResource BooleanToVisibilityConverter}}" />
        </Style>
    </Window.Resources>

    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Bottom"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,14,0,0">
            <Button Content="Save"
                    Command="{Binding SaveCommand}"
                    MinWidth="84"
                    Height="32"
                    Margin="0,0,8,0" />
            <Button Content="Cancel"
                    Click="OnCancel"
                    MinWidth="84"
                    Height="32" />
        </StackPanel>

        <Border DockPanel.Dock="Top"
                Background="#FFF4E5"
                BorderBrush="#D58512"
                BorderThickness="1"
                Padding="10"
                Margin="0,0,0,12"
                Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}">
            <TextBlock Text="{Binding ErrorMessage}"
                       TextWrapping="Wrap" />
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Student"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Margin="0,0,0,10" />
                    <TextBlock Text="Short name" />
                    <TextBox Text="{Binding ShortName, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,3,0,8" />
                    <TextBlock Text="Full name" />
                    <TextBox Text="{Binding FullName, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,3,0,8" />
                    <TextBlock Text="Address" />
                    <TextBox Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,3,0,4" />
                    <TextBox Text="{Binding AddressLine2, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,3,0,8" />
                    <TextBlock Text="Phone" />
                    <TextBox Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,3,0,8" />
                    <TextBlock Text="Email" />
                    <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,3,0,8" />
                    <TextBlock Text="Age bracket" />
                    <ComboBox ItemsSource="{Binding AgeBracketOptions}"
                              SelectedItem="{Binding AgeBracket}"
                              Margin="0,3,0,8" />
                    <TextBlock Text="Birthdate" />
                    <DatePicker SelectedDate="{Binding BirthdateDate, UpdateSourceTrigger=PropertyChanged}"
                                Margin="0,3,0,8" />
                    <CheckBox Content="Active"
                              IsChecked="{Binding IsActive}"
                              Margin="0,4,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="Current Plan"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Margin="0,0,0,10" />

                    <TextBlock Text="Active plan" />
                    <ComboBox ItemsSource="{Binding AssignablePlans}"
                              SelectedItem="{Binding SelectedAssignablePlan, UpdateSourceTrigger=PropertyChanged}"
                              DisplayMemberPath="Name"
                              IsEnabled="{Binding HasAssignablePlans}"
                              Margin="0,3,0,4" />
                    <TextBlock Text="No active plans are available."
                               Foreground="#555555"
                               Margin="0,0,0,8"
                               Visibility="{Binding HasNoAssignablePlans, Converter={StaticResource BooleanToVisibilityConverter}}" />

                    <TextBlock Text="Plan name"
                               Style="{StaticResource CurrentPlanDetailTextStyle}" />
                    <TextBlock Text="{Binding PlanName}"
                               Margin="0,3,0,8"
                               FontWeight="SemiBold"
                               Style="{StaticResource CurrentPlanDetailTextStyle}" />
                    <TextBlock Text="Price without VAT"
                               Style="{StaticResource CurrentPlanDetailTextStyle}" />
                    <TextBlock Text="{Binding PlanPriceWithoutVatText}"
                               Margin="0,3,0,8"
                               Style="{StaticResource CurrentPlanDetailTextStyle}" />
                    <TextBlock Text="Lessons per week"
                               Style="{StaticResource CurrentPlanDetailTextStyle}" />
                    <TextBlock Text="{Binding LessonsPerWeekText}"
                               Margin="0,3,0,8"
                               Style="{StaticResource CurrentPlanDetailTextStyle}" />
                    <TextBlock Text="Duration minutes"
                               Style="{StaticResource CurrentPlanDetailTextStyle}" />
                    <TextBlock Text="{Binding PlanDurationMinutesText}"
                               Margin="0,3,0,8"
                               Style="{StaticResource CurrentPlanDetailTextStyle}" />
                    <TextBlock Text="Flexibility"
                               Style="{StaticResource CurrentPlanDetailTextStyle}" />
                    <TextBlock Text="{Binding PlanFlexibilityText}"
                               Margin="0,3,0,8"
                               Style="{StaticResource CurrentPlanDetailTextStyle}" />
                    <TextBlock Text="Number of students"
                               Style="{StaticResource CurrentPlanDetailTextStyle}" />
                    <TextBlock Text="{Binding PlanNumberOfStudentsText}"
                               Margin="0,3,0,8"
                               Style="{StaticResource CurrentPlanDetailTextStyle}" />
                    <TextBlock Text="Effective date"
                               Style="{StaticResource CurrentPlanDetailTextStyle}" />
                    <TextBlock Text="{Binding PlanEffectiveDate, StringFormat={}{0:dd-MM-yyyy}}"
                               Margin="0,3,0,8"
                               Style="{StaticResource CurrentPlanDetailTextStyle}" />
                    <TextBlock Text="Payment terms"
                               Style="{StaticResource CurrentPlanDetailTextStyle}" />
                    <TextBlock Text="{Binding PlanPaymentTerms}"
                               Margin="0,3,0,8"
                               Style="{StaticResource CurrentPlanDetailTextStyle}" />
                    <TextBlock Text="Starts on"
                               Style="{StaticResource CurrentPlanDetailTextStyle}" />
                    <DatePicker SelectedDate="{Binding PlanStartsOnDate, UpdateSourceTrigger=PropertyChanged}"
                                Margin="0,3,0,8"
                                Style="{StaticResource CurrentPlanDetailDatePickerStyle}" />
                    <TextBlock Text="Ends on"
                               Style="{StaticResource CurrentPlanDetailTextStyle}" />
                    <DatePicker SelectedDate="{Binding PlanEndsOnDate, UpdateSourceTrigger=PropertyChanged}"
                                Margin="0,3,0,12"
                                Style="{StaticResource CurrentPlanDetailDatePickerStyle}" />

                    <TextBlock Text="Schedule"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Margin="0,2,0,10" />
                    <ItemsControl ItemsSource="{Binding SchedulePlacements}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="70" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="84" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Label}"
                                               VerticalAlignment="Center" />
                                    <ComboBox Grid.Column="1"
                                              ItemsSource="{Binding WeekdayOptions}"
                                              DisplayMemberPath="Label"
                                              SelectedItem="{Binding SelectedWeekday}" />
                                    <TextBox Grid.Column="3"
                                             Text="{Binding TimeText, UpdateSourceTrigger=PropertyChanged}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </DockPanel>
</Window>
