<Window x:Class="MySmallBusinessLedger.App.Views.StudentDetailsView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
        Title="Student Details"
        Height="735"
        Width="1080"
        MinHeight="735"
        MinWidth="1080"
        ResizeMode="CanMinimize">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <Style x:Key="PaneHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#15191F" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="#2F3742" />
            <Setter Property="Margin" Value="0,0,0,2" />
        </Style>
        <Style x:Key="FieldInputStyle" TargetType="Control">
            <Setter Property="Height" Value="24" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,3,0,8" />
        </Style>
        <Style x:Key="PlanDetailTextStyle" TargetType="TextBlock">
            <Setter Property="Visibility"
                    Value="{Binding HasSelectedPlan, Converter={StaticResource BooleanToVisibilityConverter}}" />
        </Style>
        <Style x:Key="PlanDetailLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource PlanDetailTextStyle}">
            <Setter Property="Margin" Value="0,0,0,2" />
        </Style>
        <Style x:Key="PlanDetailValueTextStyle" TargetType="TextBlock" BasedOn="{StaticResource PlanDetailTextStyle}">
            <Setter Property="LineHeight" Value="24" />
            <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
            <Setter Property="Margin" Value="0,3,0,8" />
        </Style>
        <Style x:Key="PlanDetailDatePickerStyle" TargetType="DatePicker">
            <Setter Property="Height" Value="24" />
            <Setter Property="Visibility"
                    Value="{Binding HasSelectedPlan, Converter={StaticResource BooleanToVisibilityConverter}}" />
            <Setter Property="Margin" Value="0,3,0,8" />
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid x:Name="StudentDetailsOuterColumns"
              Grid.Row="0"
              HorizontalAlignment="Left">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="550" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="432" />
            </Grid.ColumnDefinitions>

            <Grid x:Name="StudentDetailsColumns"
                  Grid.Column="0"
                  Visibility="{Binding HasSelectedStudentEditor, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="252" />
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="280" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Text="Student" Style="{StaticResource PaneHeaderStyle}" />
                <TextBlock Grid.Column="2"
                           Text="Student Plan"
                           Style="{StaticResource PaneHeaderStyle}" />
                <Border Grid.Row="1"
                        Grid.ColumnSpan="3"
                        Background="#FFF4E5"
                        BorderBrush="#D58512"
                        BorderThickness="1"
                        Padding="8"
                        Margin="0,0,0,10"
                        Visibility="{Binding SelectedStudentEditor.HasError, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="{Binding SelectedStudentEditor.ErrorMessage}"
                               TextWrapping="Wrap" />
                </Border>
                <ScrollViewer Grid.Row="2"
                              Grid.ColumnSpan="3"
                              VerticalScrollBarVisibility="Auto">
                    <Grid x:Name="StudentDetailsFieldsGrid"
                          DataContext="{Binding SelectedStudentEditor}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="252" />
                            <ColumnDefinition Width="18" />
                            <ColumnDefinition Width="280" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Row="0"
                                    Grid.Column="0">
                            <TextBlock Text="Short name" Style="{StaticResource FieldLabelStyle}" />
                            <TextBox Text="{Binding ShortName, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource FieldInputStyle}" />
                        </StackPanel>
                        <StackPanel Grid.Row="1"
                                    Grid.Column="0">
                            <TextBlock Text="Full name" Style="{StaticResource FieldLabelStyle}" />
                            <TextBox Text="{Binding FullName, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource FieldInputStyle}" />
                        </StackPanel>
                        <StackPanel Grid.Row="2"
                                    Grid.Column="0">
                            <TextBlock Text="Address" Style="{StaticResource FieldLabelStyle}" />
                            <TextBox Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource FieldInputStyle}"
                                     Margin="0,3,0,4" />
                        </StackPanel>
                        <StackPanel Grid.Row="3"
                                    Grid.Column="0">
                            <TextBox Text="{Binding AddressLine2, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource FieldInputStyle}" />
                        </StackPanel>
                        <StackPanel Grid.Row="4"
                                    Grid.Column="0">
                            <TextBlock Text="Phone" Style="{StaticResource FieldLabelStyle}" />
                            <TextBox Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource FieldInputStyle}" />
                        </StackPanel>
                        <StackPanel Grid.Row="5"
                                    Grid.Column="0">
                            <TextBlock Text="Email" Style="{StaticResource FieldLabelStyle}" />
                            <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource FieldInputStyle}" />
                        </StackPanel>
                        <StackPanel Grid.Row="6"
                                    Grid.Column="0">
                            <TextBlock Text="Age bracket" Style="{StaticResource FieldLabelStyle}" />
                            <ComboBox ItemsSource="{Binding AgeBracketOptions}"
                                      SelectedItem="{Binding AgeBracket}"
                                      Style="{StaticResource FieldInputStyle}" />
                        </StackPanel>
                        <StackPanel Grid.Row="7"
                                    Grid.Column="0">
                            <TextBlock Text="Birthdate" Style="{StaticResource FieldLabelStyle}" />
                            <DatePicker SelectedDate="{Binding BirthdateDate, UpdateSourceTrigger=PropertyChanged}"
                                        Style="{StaticResource FieldInputStyle}" />
                        </StackPanel>
                        <StackPanel Grid.Row="8"
                                    Grid.Column="0">
                            <CheckBox Content="Active"
                                      IsChecked="{Binding IsActive}"
                                      Margin="0,4,0,0" />
                        </StackPanel>

                        <StackPanel Grid.Row="0"
                                    Grid.Column="2">
                            <TextBlock Text="Active plan" Style="{StaticResource FieldLabelStyle}" />
                            <ComboBox ItemsSource="{Binding AssignablePlans}"
                                      SelectedItem="{Binding SelectedAssignablePlan, UpdateSourceTrigger=PropertyChanged}"
                                      DisplayMemberPath="Name"
                                      IsEnabled="{Binding HasAssignablePlans}"
                                      Height="24"
                                      VerticalContentAlignment="Center"
                                      Margin="0,3,0,12" />
                            <TextBlock Text="No active plans are available."
                                       Foreground="#555555"
                                       Margin="0,0,0,8"
                                       Visibility="{Binding HasNoAssignablePlans, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        </StackPanel>
                        <StackPanel x:Name="PlanPriceWithoutVatGroup"
                                    Grid.Row="1"
                                    Grid.Column="2">
                            <TextBlock Text="Price without VAT:" Style="{StaticResource PlanDetailLabelStyle}" />
                            <TextBlock Text="{Binding PlanPriceWithoutVatText}"
                                       Style="{StaticResource PlanDetailValueTextStyle}" />
                        </StackPanel>
                        <StackPanel x:Name="PlanLessonsGroup"
                                    Grid.Row="2"
                                    Grid.Column="2">
                            <TextBlock Text="Lessons:" Style="{StaticResource PlanDetailLabelStyle}" />
                            <TextBlock Text="{Binding LessonsPerWeekText}"
                                       Style="{StaticResource PlanDetailValueTextStyle}" />
                        </StackPanel>
                        <StackPanel x:Name="PlanDurationGroup"
                                    Grid.Row="3"
                                    Grid.Column="2">
                            <TextBlock Text="Duration:" Style="{StaticResource PlanDetailLabelStyle}" />
                            <TextBlock Text="{Binding PlanDurationMinutesText}"
                                       Style="{StaticResource PlanDetailValueTextStyle}" />
                        </StackPanel>
                        <StackPanel x:Name="PlanNumberOfStudentsGroup"
                                    Grid.Row="4"
                                    Grid.Column="2">
                            <TextBlock Text="Number of students:" Style="{StaticResource PlanDetailLabelStyle}" />
                            <TextBlock Text="{Binding PlanNumberOfStudentsText}"
                                       Style="{StaticResource PlanDetailValueTextStyle}" />
                        </StackPanel>
                        <StackPanel x:Name="PlanFlexibilityGroup"
                                    Grid.Row="5"
                                    Grid.Column="2">
                            <TextBlock Text="Flexibility:" Style="{StaticResource PlanDetailLabelStyle}" />
                            <TextBlock Text="{Binding PlanFlexibilityText}"
                                       Style="{StaticResource PlanDetailValueTextStyle}" />
                        </StackPanel>
                        <StackPanel x:Name="PlanPaymentTermsGroup"
                                    Grid.Row="6"
                                    Grid.Column="2">
                            <TextBlock Text="Payment terms:" Style="{StaticResource PlanDetailLabelStyle}" />
                            <TextBlock Text="{Binding PlanPaymentTerms}"
                                       Style="{StaticResource PlanDetailValueTextStyle}" />
                        </StackPanel>
                        <StackPanel x:Name="PlanStartsOnGroup"
                                    Grid.Row="7"
                                    Grid.Column="2">
                            <TextBlock Text="Starts on" Style="{StaticResource PlanDetailLabelStyle}" />
                            <DatePicker SelectedDate="{Binding PlanStartsOnDate, UpdateSourceTrigger=PropertyChanged}"
                                        Width="132"
                                        HorizontalAlignment="Left"
                                        Style="{StaticResource PlanDetailDatePickerStyle}" />
                        </StackPanel>
                        <StackPanel x:Name="PlanEndsOnGroup"
                                    Grid.Row="8"
                                    Grid.Column="2">
                            <TextBlock Text="Ends on" Style="{StaticResource PlanDetailLabelStyle}" />
                            <DatePicker SelectedDate="{Binding PlanEndsOnDate, UpdateSourceTrigger=PropertyChanged}"
                                        Width="132"
                                        HorizontalAlignment="Left"
                                        Style="{StaticResource PlanDetailDatePickerStyle}">
                                <DatePicker.Resources>
                                    <Style TargetType="{x:Type primitives:DatePickerTextBox}">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="{x:Type primitives:DatePickerTextBox}">
                                                    <ScrollViewer x:Name="PART_ContentHost" />
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </DatePicker.Resources>
                            </DatePicker>
                        </StackPanel>

                        <TextBlock x:Name="ScheduleHeader"
                                   Grid.Row="9"
                                   Grid.Column="2"
                                   Text="Schedule"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Margin="0,8,0,10" />
                        <ItemsControl Grid.Row="10"
                                      Grid.Column="2"
                                      ItemsSource="{Binding SchedulePlacements}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="54" />
                                            <ColumnDefinition Width="112" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="70" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Label}"
                                                   VerticalAlignment="Center" />
                                        <ComboBox Grid.Column="1"
                                                  ItemsSource="{Binding WeekdayOptions}"
                                                  DisplayMemberPath="Label"
                                                  Height="24"
                                                  VerticalContentAlignment="Center"
                                                  SelectedItem="{Binding SelectedWeekday}" />
                                        <ComboBox Grid.Column="3"
                                                  ItemsSource="{Binding TimeOptions}"
                                                  Text="{Binding TimeText, UpdateSourceTrigger=PropertyChanged}"
                                                  Height="24"
                                                  VerticalContentAlignment="Center"
                                                  IsEditable="True"
                                                  IsTextSearchEnabled="False" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </ScrollViewer>
            </Grid>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Text="Student Invoices" Style="{StaticResource PaneHeaderStyle}" />
                <DataGrid x:Name="InvoicesGrid"
                          Grid.Row="1"
                          ItemsSource="{Binding Invoices}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          CanUserResizeColumns="False"
                          CanUserResizeRows="False"
                          IsReadOnly="True"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          SelectionMode="Single"
                          MouseDoubleClick="OnInvoiceDoubleClick"
                          AutomationProperties.Name="Student invoices">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Invoice"
                                            Binding="{Binding InvoiceNumberText}"
                                            Width="75" />
                        <DataGridTextColumn Header="Date"
                                            Binding="{Binding InvoiceDateText}"
                                            Width="90" />
                        <DataGridTextColumn Header="Period"
                                            Binding="{Binding PeriodText}"
                                            Width="90" />
                        <DataGridTextColumn Header="Print"
                                            Binding="{Binding PrintStatusText}"
                                            Width="80" />
                        <DataGridTextColumn Header="Status"
                                            Binding="{Binding PaymentStatusText}"
                                            Width="95" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Grid>

        <StackPanel x:Name="StudentDetailsBottomActions"
                    Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Left"
                    Margin="0">
            <Button Content="Save"
                    Command="{Binding SaveStudentCommand}"
                    MinWidth="84"
                    Height="30"
                    Margin="0,0,8,0" />
            <Button Content="Close"
                    MinWidth="84"
                    Height="30"
                    Click="OnClose" />
        </StackPanel>
    </Grid>
</Window>
