<Window x:Class="MySmallBusinessLedger.App.Views.EconomyOverviewView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Economy Overview"
        Width="1040"
        Height="760"
        MinWidth="920"
        MinHeight="720"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <SolidColorBrush x:Key="EconomyTableBorderBrush"
                         Color="#202020" />
        <SolidColorBrush x:Key="EconomyTableGridLineBrush"
                         Color="#C8C8C8" />
        <Style x:Key="EconomyTableStyle" TargetType="{x:Type DataGrid}">
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="CanUserDeleteRows" Value="False" />
            <Setter Property="CanUserReorderColumns" Value="False" />
            <Setter Property="CanUserResizeColumns" Value="False" />
            <Setter Property="CanUserResizeRows" Value="False" />
            <Setter Property="BorderBrush" Value="{StaticResource EconomyTableBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="GridLinesVisibility" Value="All" />
            <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource EconomyTableGridLineBrush}" />
            <Setter Property="VerticalGridLinesBrush" Value="{StaticResource EconomyTableGridLineBrush}" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
        </Style>
    </Window.Resources>
    <DockPanel Margin="20" LastChildFill="True">
        <StackPanel DockPanel.Dock="Top"
                    Orientation="Horizontal"
                    Margin="0,0,0,16">
            <Button Command="{Binding PreviousYearCommand}"
                    Width="34"
                    Height="28"
                    Content="&lt;"
                    AutomationProperties.Name="Previous year" />
            <TextBlock Text="{Binding YearText}"
                       FontSize="22"
                       FontWeight="SemiBold"
                       Margin="12,0"
                       VerticalAlignment="Center" />
            <Button Command="{Binding NextYearCommand}"
                    Width="34"
                    Height="28"
                    Content="&gt;"
                    AutomationProperties.Name="Next year" />
            <Button Command="{Binding ExportCsvCommand}"
                    Content="Export CSV"
                    Width="100"
                    Height="30"
                    Margin="24,0,0,0" />
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,16,0,0">
            <TextBlock Text="{Binding ErrorMessage}"
                       Foreground="#A00000"
                       VerticalAlignment="Center"
                       Margin="0,0,16,0" />
            <Button Content="Close"
                    Width="84"
                    Height="30"
                    IsCancel="True" />
        </StackPanel>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="370" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Text="Invoices"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Margin="0,0,0,8" />
                <DataGrid x:Name="InvoicesGrid"
                          Grid.Row="1"
                          Style="{StaticResource EconomyTableStyle}"
                          ItemsSource="{Binding Invoices}"
                          MouseDoubleClick="InvoicesGrid_MouseDoubleClick">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Invoice"
                                            Binding="{Binding InvoiceNumberText}"
                                            Width="70" />
                        <DataGridTextColumn Header="Filename"
                                            Binding="{Binding PdfFileName}"
                                            Width="*" />
                        <DataGridTextColumn Header="Net"
                                            Binding="{Binding NetText}"
                                            Width="110" />
                        <DataGridTextColumn Header="VAT"
                                            Binding="{Binding VatText}"
                                            Width="110" />
                        <DataGridTextColumn Header="Total"
                                            Binding="{Binding TotalText}"
                                            Width="110" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="16" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="16" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Text="Months"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Margin="0,0,0,8" />
                <DataGrid Grid.Row="1"
                          Style="{StaticResource EconomyTableStyle}"
                          ItemsSource="{Binding Months}"
                          Height="254"
                          RowHeight="19"
                          ColumnHeaderHeight="24"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          ScrollViewer.VerticalScrollBarVisibility="Disabled">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Month"
                                            Binding="{Binding Label}"
                                            Width="80" />
                        <DataGridTextColumn Header="Net"
                                            Binding="{Binding NetText}"
                                            Width="100" />
                        <DataGridTextColumn Header="VAT"
                                            Binding="{Binding VatText}"
                                            Width="90" />
                        <DataGridTextColumn Header="Total"
                                            Binding="{Binding TotalText}"
                                            Width="100" />
                    </DataGrid.Columns>
                </DataGrid>

                <TextBlock Grid.Row="3"
                           Text="Quarters"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Margin="0,0,0,8" />
                <DataGrid Grid.Row="4"
                          Style="{StaticResource EconomyTableStyle}"
                          ItemsSource="{Binding Quarters}"
                          Height="102"
                          RowHeight="19"
                          ColumnHeaderHeight="24"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          ScrollViewer.VerticalScrollBarVisibility="Disabled">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Quarter"
                                            Binding="{Binding Label}"
                                            Width="80" />
                        <DataGridTextColumn Header="Net"
                                            Binding="{Binding NetText}"
                                            Width="100" />
                        <DataGridTextColumn Header="VAT"
                                            Binding="{Binding VatText}"
                                            Width="90" />
                        <DataGridTextColumn Header="Total"
                                            Binding="{Binding TotalText}"
                                            Width="100" />
                    </DataGrid.Columns>
                </DataGrid>

                <TextBlock Grid.Row="6"
                           Text="Years"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Margin="0,0,0,8" />
                <DataGrid Grid.Row="7"
                          Style="{StaticResource EconomyTableStyle}"
                          ItemsSource="{Binding Years}"
                          Height="121"
                          RowHeight="19"
                          ColumnHeaderHeight="24"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          ScrollViewer.VerticalScrollBarVisibility="Disabled">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Year"
                                            Binding="{Binding Label}"
                                            Width="80" />
                        <DataGridTextColumn Header="Net"
                                            Binding="{Binding NetText}"
                                            Width="100" />
                        <DataGridTextColumn Header="VAT"
                                            Binding="{Binding VatText}"
                                            Width="90" />
                        <DataGridTextColumn Header="Total"
                                            Binding="{Binding TotalText}"
                                            Width="100" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
