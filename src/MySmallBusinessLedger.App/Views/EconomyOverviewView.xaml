<Window x:Class="MySmallBusinessLedger.App.Views.EconomyOverviewView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Economy Overview"
        Width="980"
        Height="680"
        MinWidth="860"
        MinHeight="560"
        WindowStartupLocation="CenterOwner">
    <DockPanel Margin="20" LastChildFill="True">
        <StackPanel DockPanel.Dock="Top"
                    Orientation="Horizontal"
                    Margin="0,0,0,16">
            <Button Command="{Binding PreviousYearCommand}"
                    Width="34"
                    Height="28"
                    Content="&lt;"
                    AutomationProperties.Name="Previous year" />
            <TextBlock Text="{Binding YearText}"
                       FontSize="22"
                       FontWeight="SemiBold"
                       Margin="12,0"
                       VerticalAlignment="Center" />
            <Button Command="{Binding NextYearCommand}"
                    Width="34"
                    Height="28"
                    Content="&gt;"
                    AutomationProperties.Name="Next year" />
            <Button Command="{Binding ExportCsvCommand}"
                    Content="Export CSV"
                    Width="100"
                    Height="30"
                    Margin="24,0,0,0" />
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,16,0,0">
            <TextBlock Text="{Binding ErrorMessage}"
                       Foreground="#A00000"
                       VerticalAlignment="Center"
                       Margin="0,0,16,0" />
            <Button Content="Close"
                    Width="84"
                    Height="30"
                    IsCancel="True" />
        </StackPanel>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="2*" />
                <RowDefinition Height="16" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Row="0"
                  Grid.ColumnSpan="3">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Text="Invoices"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Margin="0,0,0,8" />
                <DataGrid x:Name="InvoicesGrid"
                          Grid.Row="1"
                          ItemsSource="{Binding Invoices}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          IsReadOnly="True"
                          HeadersVisibility="Column"
                          MouseDoubleClick="InvoicesGrid_MouseDoubleClick">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Invoice"
                                            Binding="{Binding InvoiceNumberText}"
                                            Width="90" />
                        <DataGridTextColumn Header="Filename"
                                            Binding="{Binding PdfFileName}"
                                            Width="*" />
                        <DataGridTextColumn Header="Net"
                                            Binding="{Binding NetText}"
                                            Width="130" />
                        <DataGridTextColumn Header="VAT"
                                            Binding="{Binding VatText}"
                                            Width="130" />
                        <DataGridTextColumn Header="Total"
                                            Binding="{Binding TotalText}"
                                            Width="130" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>

            <Grid Grid.Row="2"
                  Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Text="Months"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Margin="0,0,0,8" />
                <DataGrid Grid.Row="1"
                          ItemsSource="{Binding Months}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          IsReadOnly="True"
                          HeadersVisibility="Column">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Month"
                                            Binding="{Binding Label}"
                                            Width="*" />
                        <DataGridTextColumn Header="Net"
                                            Binding="{Binding NetText}"
                                            Width="110" />
                        <DataGridTextColumn Header="VAT"
                                            Binding="{Binding VatText}"
                                            Width="110" />
                        <DataGridTextColumn Header="Total"
                                            Binding="{Binding TotalText}"
                                            Width="110" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>

            <Grid Grid.Row="2"
                  Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Text="Quarters"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Margin="0,0,0,8" />
                <DataGrid Grid.Row="1"
                          ItemsSource="{Binding Quarters}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          IsReadOnly="True"
                          HeadersVisibility="Column">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Quarter"
                                            Binding="{Binding Label}"
                                            Width="*" />
                        <DataGridTextColumn Header="Net"
                                            Binding="{Binding NetText}"
                                            Width="110" />
                        <DataGridTextColumn Header="VAT"
                                            Binding="{Binding VatText}"
                                            Width="110" />
                        <DataGridTextColumn Header="Total"
                                            Binding="{Binding TotalText}"
                                            Width="110" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>

            <StackPanel Grid.Row="3"
                        Grid.ColumnSpan="3"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,16,0,0">
                <TextBlock Text="Year to date:"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           Margin="0,0,16,0" />
                <TextBlock Text="Net"
                           VerticalAlignment="Center"
                           Margin="0,0,6,0" />
                <TextBlock Text="{Binding YearToDateNetText}"
                           Width="120"
                           VerticalAlignment="Center" />
                <TextBlock Text="VAT"
                           VerticalAlignment="Center"
                           Margin="16,0,6,0" />
                <TextBlock Text="{Binding YearToDateVatText}"
                           Width="120"
                           VerticalAlignment="Center" />
                <TextBlock Text="Total"
                           VerticalAlignment="Center"
                           Margin="16,0,6,0" />
                <TextBlock Text="{Binding YearToDateTotalText}"
                           Width="120"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center" />
            </StackPanel>
        </Grid>
    </DockPanel>
</Window>
