<Window x:Class="MySmallBusinessLedger.App.Views.StudentOverviewView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Manage Students"
        Height="680"
        Width="1220"
        MinHeight="600"
        MinWidth="1100">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <Style x:Key="PaneHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#15191F" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="#2F3742" />
            <Setter Property="Margin" Value="0,0,0,2" />
        </Style>
        <Style x:Key="FieldInputStyle" TargetType="Control">
            <Setter Property="Margin" Value="0,3,0,8" />
        </Style>
        <Style x:Key="PlanDetailTextStyle" TargetType="TextBlock">
            <Setter Property="Visibility"
                    Value="{Binding HasSelectedPlan, Converter={StaticResource BooleanToVisibilityConverter}}" />
        </Style>
        <Style x:Key="PlanDetailDatePickerStyle" TargetType="DatePicker">
            <Setter Property="Visibility"
                    Value="{Binding HasSelectedPlan, Converter={StaticResource BooleanToVisibilityConverter}}" />
            <Setter Property="Margin" Value="0,3,0,8" />
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="#FFF4E5"
                BorderBrush="#D58512"
                BorderThickness="1"
                Padding="10"
                Margin="0,0,0,14"
                Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}">
            <DockPanel>
                <Button DockPanel.Dock="Right"
                        Content="x"
                        Command="{Binding DismissErrorCommand}"
                        Width="24"
                        Height="22"
                        Margin="10,0,0,0"
                        AutomationProperties.Name="Dismiss message" />
                <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="#5F370E"
                           TextWrapping="Wrap" />
            </DockPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.55*" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="2.05*" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="1.05*" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Text="Students" Style="{StaticResource PaneHeaderStyle}" />
                <DataGrid x:Name="StudentsGrid"
                          Grid.Row="1"
                          ItemsSource="{Binding Students}"
                          SelectedItem="{Binding SelectedStudent, Mode=TwoWay}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          IsReadOnly="True"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          SelectionMode="Single"
                          AutomationProperties.Name="Student list">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Short name"
                                            Binding="{Binding ShortName}"
                                            Width="92" />
                        <DataGridTextColumn Header="Full name"
                                            Binding="{Binding FullName}"
                                            Width="135" />
                        <DataGridTextColumn Header="Phone"
                                            Binding="{Binding Phone}"
                                            Width="90" />
                        <DataGridTextColumn Header="Email"
                                            Binding="{Binding Email}"
                                            Width="*" />
                        <DataGridTextColumn Header="State"
                                            Binding="{Binding StateText}"
                                            Width="72" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>

            <Grid Grid.Column="2"
                  Visibility="{Binding HasSelectedStudentEditor, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Text="Student" Style="{StaticResource PaneHeaderStyle}" />
                <Border Grid.Row="1"
                        Background="#FFF4E5"
                        BorderBrush="#D58512"
                        BorderThickness="1"
                        Padding="8"
                        Margin="0,0,0,10"
                        Visibility="{Binding SelectedStudentEditor.HasError, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="{Binding SelectedStudentEditor.ErrorMessage}"
                               TextWrapping="Wrap" />
                </Border>
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                    <Grid DataContext="{Binding SelectedStudentEditor}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="18" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Short name" Style="{StaticResource FieldLabelStyle}" />
                            <TextBox Text="{Binding ShortName, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource FieldInputStyle}" />
                            <TextBlock Text="Full name" Style="{StaticResource FieldLabelStyle}" />
                            <TextBox Text="{Binding FullName, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource FieldInputStyle}" />
                            <TextBlock Text="Address" Style="{StaticResource FieldLabelStyle}" />
                            <TextBox Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,3,0,4" />
                            <TextBox Text="{Binding AddressLine2, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource FieldInputStyle}" />
                            <TextBlock Text="Phone" Style="{StaticResource FieldLabelStyle}" />
                            <TextBox Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource FieldInputStyle}" />
                            <TextBlock Text="Email" Style="{StaticResource FieldLabelStyle}" />
                            <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource FieldInputStyle}" />
                            <TextBlock Text="Age bracket" Style="{StaticResource FieldLabelStyle}" />
                            <ComboBox ItemsSource="{Binding AgeBracketOptions}"
                                      SelectedItem="{Binding AgeBracket}"
                                      Style="{StaticResource FieldInputStyle}" />
                            <TextBlock Text="Birthdate" Style="{StaticResource FieldLabelStyle}" />
                            <DatePicker SelectedDate="{Binding BirthdateDate, UpdateSourceTrigger=PropertyChanged}"
                                        Style="{StaticResource FieldInputStyle}" />
                            <CheckBox Content="Active"
                                      IsChecked="{Binding IsActive}"
                                      Margin="0,4,0,0" />
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Current Plan"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,10" />

                            <TextBlock Text="Active plan" Style="{StaticResource FieldLabelStyle}" />
                            <ComboBox ItemsSource="{Binding AssignablePlans}"
                                      SelectedItem="{Binding SelectedAssignablePlan, UpdateSourceTrigger=PropertyChanged}"
                                      DisplayMemberPath="Name"
                                      IsEnabled="{Binding HasAssignablePlans}"
                                      Margin="0,3,0,4" />
                            <TextBlock Text="No active plans are available."
                                       Foreground="#555555"
                                       Margin="0,0,0,8"
                                       Visibility="{Binding HasNoAssignablePlans, Converter={StaticResource BooleanToVisibilityConverter}}" />

                            <TextBlock Text="Plan name" Style="{StaticResource PlanDetailTextStyle}" />
                            <TextBlock Text="{Binding PlanName}"
                                       Margin="0,3,0,8"
                                       FontWeight="SemiBold"
                                       Style="{StaticResource PlanDetailTextStyle}" />
                            <TextBlock Text="Price without VAT" Style="{StaticResource PlanDetailTextStyle}" />
                            <TextBlock Text="{Binding PlanPriceWithoutVatText}"
                                       Margin="0,3,0,8"
                                       Style="{StaticResource PlanDetailTextStyle}" />
                            <TextBlock Text="Lessons per week" Style="{StaticResource PlanDetailTextStyle}" />
                            <TextBlock Text="{Binding LessonsPerWeekText}"
                                       Margin="0,3,0,8"
                                       Style="{StaticResource PlanDetailTextStyle}" />
                            <TextBlock Text="Duration minutes" Style="{StaticResource PlanDetailTextStyle}" />
                            <TextBlock Text="{Binding PlanDurationMinutesText}"
                                       Margin="0,3,0,8"
                                       Style="{StaticResource PlanDetailTextStyle}" />
                            <TextBlock Text="Number of students" Style="{StaticResource PlanDetailTextStyle}" />
                            <TextBlock Text="{Binding PlanNumberOfStudentsText}"
                                       Margin="0,3,0,8"
                                       Style="{StaticResource PlanDetailTextStyle}" />
                            <TextBlock Text="Flexibility" Style="{StaticResource PlanDetailTextStyle}" />
                            <TextBlock Text="{Binding PlanFlexibilityText}"
                                       Margin="0,3,0,8"
                                       Style="{StaticResource PlanDetailTextStyle}" />
                            <TextBlock Text="Payment terms" Style="{StaticResource PlanDetailTextStyle}" />
                            <TextBlock Text="{Binding PlanPaymentTerms}"
                                       Margin="0,3,0,8"
                                       Style="{StaticResource PlanDetailTextStyle}" />
                            <TextBlock Text="Effective date" Style="{StaticResource PlanDetailTextStyle}" />
                            <TextBlock Text="{Binding PlanEffectiveDate, StringFormat={}{0:dd-MM-yyyy}}"
                                       Margin="0,3,0,8"
                                       Style="{StaticResource PlanDetailTextStyle}" />
                            <TextBlock Text="Starts on" Style="{StaticResource PlanDetailTextStyle}" />
                            <DatePicker SelectedDate="{Binding PlanStartsOnDate, UpdateSourceTrigger=PropertyChanged}"
                                        Style="{StaticResource PlanDetailDatePickerStyle}" />
                            <TextBlock Text="Ends on" Style="{StaticResource PlanDetailTextStyle}" />
                            <DatePicker SelectedDate="{Binding PlanEndsOnDate, UpdateSourceTrigger=PropertyChanged}"
                                        Style="{StaticResource PlanDetailDatePickerStyle}" />

                            <TextBlock Text="Schedule"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Margin="0,8,0,10" />
                            <ItemsControl ItemsSource="{Binding SchedulePlacements}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="70" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="8" />
                                                <ColumnDefinition Width="84" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Label}"
                                                       VerticalAlignment="Center" />
                                            <ComboBox Grid.Column="1"
                                                      ItemsSource="{Binding WeekdayOptions}"
                                                      DisplayMemberPath="Label"
                                                      SelectedItem="{Binding SelectedWeekday}" />
                                            <TextBox Grid.Column="3"
                                                     Text="{Binding TimeText, UpdateSourceTrigger=PropertyChanged}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </Grid>

            <Grid Grid.Column="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Text="Invoices" Style="{StaticResource PaneHeaderStyle}" />
                <DataGrid x:Name="InvoicesGrid"
                          Grid.Row="1"
                          ItemsSource="{Binding Invoices}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          IsReadOnly="True"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          SelectionMode="Single"
                          MouseDoubleClick="OnInvoiceDoubleClick"
                          AutomationProperties.Name="Student invoices">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Invoice"
                                            Binding="{Binding InvoiceNumberText}"
                                            Width="90" />
                        <DataGridTextColumn Header="Date"
                                            Binding="{Binding InvoiceDateText}"
                                            Width="95" />
                        <DataGridTextColumn Header="Status"
                                            Binding="{Binding PaymentStatusText}"
                                            Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Grid>

        <Grid Grid.Row="2" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.55*" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="2.05*" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="1.05*" />
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0"
                    Content="Add Student"
                    Command="{Binding AddStudentCommand}"
                    MinWidth="96"
                    Height="30"
                    HorizontalAlignment="Left" />
            <StackPanel Grid.Column="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Left">
                <Button Content="Save"
                        Command="{Binding SaveStudentCommand}"
                        MinWidth="84"
                        Height="30"
                        Margin="0,0,8,0" />
                <Button Content="Cancel"
                        Command="{Binding CancelStudentEditCommand}"
                        MinWidth="84"
                        Height="30" />
            </StackPanel>
            <Button Grid.Column="4"
                    Content="Close"
                    MinWidth="84"
                    Height="30"
                    HorizontalAlignment="Right"
                    Click="OnClose" />
        </Grid>
    </Grid>
</Window>
