<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\MySmallBusinessLedger.Core\MySmallBusinessLedger.Core.csproj" />
    <ProjectReference Include="..\MySmallBusinessLedger.Infrastructure\MySmallBusinessLedger.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Configuration\google-oauth-client.json"
          CopyToOutputDirectory="PreserveNewest"
          Condition="Exists('Configuration\google-oauth-client.json')" />
    <None Include="Configuration\google-oauth-client.template.json" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

</Project>
