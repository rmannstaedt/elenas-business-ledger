<Window x:Class="MySmallBusinessLedger.App.Views.SettingsView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Application Settings"
        Height="680"
        Width="720"
        MinHeight="560"
        MinWidth="640"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </Window.Resources>

    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Bottom"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,14,0,0">
            <Button Content="Save"
                    Command="{Binding SaveCommand}"
                    MinWidth="84"
                    Height="32"
                    Margin="0,0,8,0" />
            <Button Content="Cancel"
                    Click="OnCancel"
                    MinWidth="84"
                    Height="32" />
        </StackPanel>

        <Border DockPanel.Dock="Top"
                Background="#FFF4E5"
                BorderBrush="#D58512"
                BorderThickness="1"
                Padding="10"
                Margin="0,0,0,12"
                Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}">
            <TextBlock Text="{Binding ErrorMessage}"
                       TextWrapping="Wrap" />
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Company"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Margin="0,0,0,10" />
                    <TextBlock Text="Name" />
                    <TextBox Text="{Binding CompanyName, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,3,0,8" />
                    <TextBlock Text="Address" />
                    <TextBox Text="{Binding CompanyAddress, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,3,0,8" />
                    <TextBlock Text="Phone" />
                    <TextBox Text="{Binding CompanyPhone, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,3,0,8" />
                    <TextBlock Text="Email" />
                    <TextBox Text="{Binding CompanyEmail, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,3,0,8" />
                    <TextBlock Text="CVR" />
                    <TextBox Text="{Binding CompanyCvr, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,3,0,8" />
                    <CheckBox Content="VAT registered"
                              IsChecked="{Binding IsVatRegistered}"
                              Margin="0,4,0,8" />
                    <TextBlock Text="VAT registration date" />
                    <DatePicker SelectedDate="{Binding VatRegistrationDate, UpdateSourceTrigger=PropertyChanged}"
                                Margin="0,3,0,8" />
                    <TextBlock Text="Invoice folder" />
                    <TextBox Text="{Binding InvoiceFolderPath, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,3,0,8" />
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="Google Calendar"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Margin="0,0,0,10" />
                    <TextBlock Text="Calendar ID" />
                    <TextBox Text="{Binding CalendarId, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,3,0,8" />
                    <TextBlock Text="Google account email" />
                    <TextBox Text="{Binding GoogleAccountEmail, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,3,0,8" />
                    <TextBlock Text="Google Calendar login setup file" />
                    <Grid Margin="0,3,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding GoogleClientSecretsSourcePath, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Grid.Column="2"
                                Content="Browse"
                                Click="OnBrowseGoogleClientSecrets"
                                MinWidth="76"
                                Height="26" />
                    </Grid>
                    <TextBlock Text="{Binding GoogleLoginSetupFileStatusText}"
                               Foreground="#5B6472"
                               Margin="0,0,0,18" />
                    <TextBlock Text="Application data"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Margin="0,8,0,10" />
                    <TextBlock Text="Database location" />
                    <TextBox Text="{Binding DatabasePath, Mode=OneWay}"
                             IsReadOnly="True"
                             Margin="0,3,0,8" />
                    <TextBlock Text="App data folder" />
                    <TextBox Text="{Binding AppDataFolderPath, Mode=OneWay}"
                             IsReadOnly="True"
                             Margin="0,3,0,8" />
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </DockPanel>
</Window>
