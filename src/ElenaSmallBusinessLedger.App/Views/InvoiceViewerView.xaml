<Window x:Class="MySmallBusinessLedger.App.Views.InvoiceViewerView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Invoice"
        Height="560"
        Width="720"
        MinHeight="500"
        MinWidth="640"
        WindowStartupLocation="CenterOwner">
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Bottom"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,14,0,0">
            <Button Content="Close"
                    Click="OnClose"
                    MinWidth="84"
                    Height="32" />
        </StackPanel>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel>
                <TextBlock Text="{Binding InvoiceNumberText, StringFormat=Invoice {0}}"
                           FontSize="22"
                           FontWeight="SemiBold" />
                <TextBlock Text="{Binding InvoiceDateText}" />
            </StackPanel>

            <Grid Grid.Row="1"
                  Margin="0,18,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Fra"
                               FontWeight="SemiBold" />
                    <TextBlock Text="{Binding CompanyName}" />
                    <TextBlock Text="{Binding CompanyAddress}" />
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="Til"
                               FontWeight="SemiBold" />
                    <TextBlock Text="{Binding StudentName}" />
                    <TextBlock Text="{Binding StudentAddress}" />
                </StackPanel>
            </Grid>

            <DataGrid Grid.Row="2"
                      ItemsSource="{Binding Lines}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Lesson"
                                        Binding="{Binding LessonDateTimeText}"
                                        Width="160" />
                    <DataGridTextColumn Header="Plan"
                                        Binding="{Binding PlanName}"
                                        Width="*" />
                    <DataGridTextColumn Header="Price without VAT"
                                        Binding="{Binding PriceWithoutVatText}"
                                        Width="150" />
                </DataGrid.Columns>
            </DataGrid>

            <Grid Grid.Row="3"
                  Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="220" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding PdfFilePath}"
                           TextWrapping="Wrap"
                           Foreground="#5B6472" />
                <StackPanel Grid.Column="1"
                            HorizontalAlignment="Right">
                    <TextBlock Text="{Binding TotalWithoutVatText, StringFormat=I alt ekskl. moms: {0}}"
                               TextAlignment="Right" />
                    <TextBlock Text="{Binding VatAmountText, StringFormat=Moms: {0}}"
                               TextAlignment="Right" />
                    <TextBlock Text="{Binding TotalText, StringFormat=I alt: {0}}"
                               FontSize="16"
                               FontWeight="SemiBold"
                               TextAlignment="Right" />
                </StackPanel>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
