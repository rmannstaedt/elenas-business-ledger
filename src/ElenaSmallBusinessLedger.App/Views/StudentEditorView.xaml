<Window x:Class="ElenaSmallBusinessLedger.App.Views.StudentEditorView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Student"
        Height="640"
        Width="720"
        MinHeight="560"
        MinWidth="640"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </Window.Resources>

    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Bottom"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,14,0,0">
            <Button Content="Save"
                    Command="{Binding SaveCommand}"
                    MinWidth="84"
                    Height="32"
                    Margin="0,0,8,0" />
            <Button Content="Cancel"
                    Click="OnCancel"
                    MinWidth="84"
                    Height="32" />
        </StackPanel>

        <Border DockPanel.Dock="Top"
                Background="#FFF4E5"
                BorderBrush="#D58512"
                BorderThickness="1"
                Padding="10"
                Margin="0,0,0,12"
                Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}">
            <TextBlock Text="{Binding ErrorMessage}"
                       TextWrapping="Wrap" />
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Student"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Margin="0,0,0,10" />
                    <TextBlock Text="Short name" />
                    <TextBox Text="{Binding ShortName, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,3,0,8" />
                    <TextBlock Text="Full name" />
                    <TextBox Text="{Binding FullName, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,3,0,8" />
                    <TextBlock Text="Address" />
                    <TextBox Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,3,0,8" />
                    <TextBlock Text="Phone" />
                    <TextBox Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,3,0,8" />
                    <TextBlock Text="Email" />
                    <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,3,0,8" />
                    <TextBlock Text="Age bracket" />
                    <ComboBox ItemsSource="{Binding AgeBracketOptions}"
                              SelectedItem="{Binding AgeBracket}"
                              Margin="0,3,0,8" />
                    <TextBlock Text="Birthdate" />
                    <TextBox Text="{Binding BirthdateText, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,3,0,8" />
                    <CheckBox Content="Active"
                              IsChecked="{Binding IsActive}"
                              Margin="0,4,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="Current Plan"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Margin="0,0,0,10" />
                    <TextBlock Text="Plan name" />
                    <TextBox Text="{Binding PlanName, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,3,0,8" />
                    <TextBlock Text="Price without VAT" />
                    <TextBox Text="{Binding PlanPriceWithoutVatText, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,3,0,8" />
                    <TextBlock Text="Lessons per week" />
                    <ComboBox ItemsSource="{Binding LessonsPerWeekOptions}"
                              SelectedItem="{Binding LessonsPerWeek}"
                              Margin="0,3,0,8" />
                    <TextBlock Text="Duration minutes" />
                    <TextBox Text="{Binding PlanDurationMinutesText, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,3,0,8" />
                    <TextBlock Text="Flexibility" />
                    <ComboBox ItemsSource="{Binding PlanFlexibilityOptions}"
                              SelectedItem="{Binding PlanFlexibility}"
                              Margin="0,3,0,8" />
                    <TextBlock Text="Number of students" />
                    <TextBox Text="{Binding PlanNumberOfStudentsText, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,3,0,8" />
                    <TextBlock Text="Effective date" />
                    <TextBox Text="{Binding PlanEffectiveDateText, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,3,0,8" />
                    <TextBlock Text="Starts on" />
                    <TextBox Text="{Binding PlanStartsOnText, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,3,0,8" />
                    <TextBlock Text="Ends on" />
                    <TextBox Text="{Binding PlanEndsOnText, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,3,0,12" />

                    <TextBlock Text="Schedule"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Margin="0,2,0,10" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="84" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ComboBox ItemsSource="{Binding WeekdayOptions}"
                                  SelectedItem="{Binding NewScheduleWeekday}" />
                        <TextBox Grid.Column="2"
                                 Text="{Binding NewScheduleTimeText, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Grid.Column="4"
                                Content="Add"
                                Command="{Binding AddScheduleCommand}"
                                MinWidth="64" />
                    </Grid>
                    <ListBox x:Name="ScheduleList"
                             ItemsSource="{Binding Schedule}"
                             DisplayMemberPath="DisplayText"
                             Height="82"
                             Margin="0,8,0,8" />
                    <Button Content="Remove Selected"
                            Command="{Binding RemoveScheduleCommand}"
                            CommandParameter="{Binding SelectedItem, ElementName=ScheduleList}"
                            HorizontalAlignment="Left"
                            MinWidth="120" />
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </DockPanel>
</Window>
