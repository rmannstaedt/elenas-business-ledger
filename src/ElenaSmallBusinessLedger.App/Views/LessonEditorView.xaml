<Window x:Class="MySmallBusinessLedger.App.Views.LessonEditorView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Lesson"
        Height="300"
        Width="420"
        MinHeight="280"
        MinWidth="380"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </Window.Resources>

    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Bottom"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,14,0,0">
            <Button Content="Save"
                    Command="{Binding SaveCommand}"
                    MinWidth="84"
                    Height="32"
                    Margin="0,0,8,0" />
            <Button Content="Cancel Lesson"
                    Command="{Binding DeleteCommand}"
                    MinWidth="104"
                    Height="32"
                    Margin="0,0,8,0" />
            <Button Content="Close"
                    Click="OnCancel"
                    MinWidth="84"
                    Height="32" />
        </StackPanel>

        <Border DockPanel.Dock="Top"
                Background="#FFF4E5"
                BorderBrush="#D58512"
                BorderThickness="1"
                Padding="10"
                Margin="0,0,0,12"
                Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}">
            <TextBlock Text="{Binding ErrorMessage}"
                       TextWrapping="Wrap" />
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Text="Student"
                       VerticalAlignment="Center"
                       Margin="0,0,8,8" />
            <TextBox Grid.Column="1"
                     Text="{Binding StudentShortName, UpdateSourceTrigger=PropertyChanged}"
                     Margin="0,0,0,8" />

            <TextBlock Grid.Row="1"
                       Text="Date"
                       VerticalAlignment="Center"
                       Margin="0,0,8,8" />
            <TextBox Grid.Row="1"
                     Grid.Column="1"
                     Text="{Binding DateText, UpdateSourceTrigger=PropertyChanged}"
                     Margin="0,0,0,8" />

            <TextBlock Grid.Row="2"
                       Text="Time"
                       VerticalAlignment="Center"
                       Margin="0,0,8,8" />
            <TextBox Grid.Row="2"
                     Grid.Column="1"
                     Text="{Binding TimeText, UpdateSourceTrigger=PropertyChanged}"
                     Margin="0,0,0,8" />

            <TextBlock Grid.Row="3"
                       Grid.ColumnSpan="2"
                       Text="Invoiced lessons cannot be edited."
                       Visibility="{Binding IsInvoiced, Converter={StaticResource BooleanToVisibilityConverter}}" />
        </Grid>
    </DockPanel>
</Window>
